# LLM (enricher + incident verdict + Codex CLI)
OPENAI_API_KEY=
# cheap enrichment model; verify current name at build time
AFR_ENRICH_MODEL=gpt-5-mini
AFR_VERDICT_MODEL=gpt-5

# Modal (sandboxed re-run)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# URL printed by `modal deploy modal/replay_sandbox.py`
AFR_MODAL_ENDPOINT=

# Greptile: the CLI is the primary path (npm i -g greptile && greptile login).
# AFR_GREPTILE_BIN=greptile
# Optional fallback — read Greptile's review comments off a GitHub PR instead.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
